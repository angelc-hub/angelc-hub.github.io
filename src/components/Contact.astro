---
import { profile, tr, type Lang } from '../data/portfolio';
import { ui } from '../data/ui';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="section reveal" aria-labelledby="contacto">
  <div class="container">
    <SectionHeading id="contacto" title={t.contactTitle} lead={t.contactLead} />
    <div class="contact-grid">
      <ul class="panel contact-list">
        <li><Icon name="mail" /><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><Icon name="phone" /><a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a></li>
        <li><Icon name="pin" /><span>{tr(profile.location, lang)}</span></li>
        <li><Icon name="github" /><a href={profile.github} target="_blank" rel="noopener noreferrer">{profile.githubUser}</a></li>
        <li><Icon name="linkedin" />
          {profile.linkedin
            ? <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            : <span class="muted">{t.linkedinMissing}</span>}
        </li>
      </ul>
      <div class="actions col">
        <Button href={`mailto:${profile.email}`} icon="mail" variant="primary">{t.sendEmail}</Button>
        <Button href={profile.whatsapp} icon="whatsapp" external>{t.whatsapp}</Button>
        <Button copy={profile.email} icon="copy">{t.copyEmail}</Button>
        <Button href={profile.github} icon="github" external>{t.visitGithub}</Button>
      </div>
    </div>
  </div>
</section>
